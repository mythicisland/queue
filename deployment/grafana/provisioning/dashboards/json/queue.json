        "x": 12,
        "y": 31,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Allocation duration",
      "description": "Time from creating a match until a server took it",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, queue_type) (rate(queue_match_allocation_duration_seconds_bucket{queue_type=~\"$queue_type\"}[$__rate_interval])))",
          "legendFormat": "p50 {{queue_type}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
