{
  "ts": {
    "$resolver": "timestamp",
    "pattern": {
      "format": "yyyy-MM-dd'T'HH:mm:ss.SSSXXX",
      "timeZone": "UTC"
    }
  },
  "level": {
    "$resolver": "level",
    "field": "name"
  },
  "caller": {
    "$resolver": "pattern",
    "pattern": "%C{1}:%L"
  },
  "msg": {
    "$resolver": "message",
    "stringified": true
  },
  "fields": {
    "$resolver": "map",
    "flatten": true
  },
  "stacktrace": {
    "$resolver": "exception",
    "field": "stackTrace",
    "stackTrace": {
      "stringified": true
    }
  }
}
